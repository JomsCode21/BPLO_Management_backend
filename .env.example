PORT=<port_number>
NODE_ENV=development
MONGO_DB_URI=mongodb://127.0.0.1:27017/<project_name>
CORS_ORIGINS=http://localhost:5173
GLOBAL_RATE_LIMIT_MINUTES=15
GLOBAL_RATE_LIMIT_MAX=100

# JWT
JWT_ACCESS_TOKEN=value
JWT_REFRESH_TOKEN=value

# Token
REFRESH_COOKIE_NAME=value
REFRESH_COOKIE_PATH=value

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
RECAPTCHA_SECRET_KEY=your_recaptcha_v2_secret_key_here

# reCAPTCHA Enterprise (required when VITE_RECAPTCHA_SITE_KEY is a Google Cloud
# reCAPTCHA Enterprise checkbox key). Create a server-only API key with access
# limited to the reCAPTCHA Enterprise API.
RECAPTCHA_ENTERPRISE_PROJECT_ID=your_google_cloud_project_id
RECAPTCHA_ENTERPRISE_API_KEY=your_server_only_google_cloud_api_key
RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_enterprise_site_key

# Mailing
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL=your_email_here
MAIL_PASSWORD=your_email_app_password_here

# Startup super admin seed
# Set to true to create a super admin account when the backend starts.
SEED_SUPER_ADMIN=false
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeThisStrongPassword
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_MIDDLE_NAME=
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_SUFFIX=
SUPER_ADMIN_GENDER=Prefer not to say
